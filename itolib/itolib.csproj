<Project Sdk="Microsoft.NET.Sdk">
    <!-- BepInEx properties. -->
    <PropertyGroup>
        <AssemblyName>itolib</AssemblyName>
        <Description>Wondrous gizmos and gadgets for the restless mind.</Description>
        <Version>0.3.1</Version>
    </PropertyGroup>

    <!-- Project properties. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>preview</LangVersion>
        <PackageLicenseFile>../LICENSE</PackageLicenseFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Code linting. -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <AnalysisMode>All</AnalysisMode>
        <AnalysisLevel>preview-recommended</AnalysisLevel>
    </PropertyGroup>

    <!-- Disable certain warnings. -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);CA1000</NoWarn>
        <NoWarn>$(NoWarn);CA1051</NoWarn>
        <NoWarn>$(NoWarn);CA1707</NoWarn>
        <NoWarn>$(NoWarn);CA1859</NoWarn>
    </PropertyGroup>

    <!-- Embedded debug. -->
    <PropertyGroup>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>embedded</DebugType>
        <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
    </PropertyGroup>

    <!-- Enable 'Nullable' types. -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.22.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.9" IncludeAssets="compile" />
        <PackageReference Include="LethalCompany.GameLibs.Steam" Version="70.0.0-ngd.0" />
        <PackageReference Include="IAmBatby.LethalLevelLoader" Version="1.4.*" Publicize="true" />
        <PackageReference Include="mrov.WeatherRegistry" Version="0.7.*" />
        <PackageReference Include="mrov.MrovLib" Version="0.3.*" />
        <Reference Include="CrowdControl" Publicize="true">
            <HintPath>managed\CrowdControl.dll</HintPath>
        </Reference>
        <Reference Include="FacilityMeltdown" Publicize="true">
            <HintPath>managed\FacilityMeltdown.dll</HintPath>
        </Reference>
        <!-- <Reference Include="LethalLevelLoader" Publicize="true">
            <HintPath>managed\LethalLevelLoader.dll</HintPath>
        </Reference> -->
        <Reference Include="PizzaTowerEscapeMusic" Publicize="true">
            <HintPath>managed\PizzaTowerEscapeMusic.dll</HintPath>
        </Reference>
        <Reference Include="TVLoader" Publicize="true">
            <HintPath>managed\TVLoader.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../LICENSE" Pack="true" PackagePath="$(PackageLicenseFile)" />
    </ItemGroup>

    <Target Name="NetcodePatch" AfterTargets="PostBuildEvent">
        <Exec Command="netcode-patch &quot;$(TargetPath)&quot; @(ReferencePathWithRefAssemblies->'&quot;%(Identity)&quot;', ' ')" />
    </Target>
</Project>